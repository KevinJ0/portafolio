{
  "name": "portafolio",
  "version": "1.0.0",
  "description": "Mi portafolio personal de proyectos webs",
  "main": "js/index.js",
  "homepage": "https://kevinj0.github.io/portafolio/",
  "scripts": {
    "sass": "sass scss/master.scss dist/css/master.css",
    "sass:watch": "sass --watch scss/master.scss dist/css/master.css",
    "copy:js": "robocopy js dist\\js /njh /njs /ndl /np",
    "build": "npm run sass && npm run copy:js",
    "deploy": "gh-pages -d dist"
  },
