# Files and folders NOT uploaded as site assets (same format as .gitignore)
# NOTE: leading slash anchors to repo root; unanchored patterns match at any depth.

# Git internals (the pack file can exceed the 25 MiB per-file asset limit)
/.git/
/.wrangler/

# Build dependencies (node_modules/workerd is 127 MiB in the Cloudflare build)
/node_modules/

# Source of styles and scripts (the site serves the compiled dist/ copies)
/js/
/scss/

# Project docs and config files
*.md
/package.json
/package-lock.json
/resize_images.py
/wrangler.toml

# Hidden tooling directories
/.impeccable/
/.serena/